
# Public endpoints only. Never place JWT secrets or tokens in Next.js environment files.
REACT_APP_API_URL=http://localhost:3007
REACT_APP_API_GRAPHQL_URL=http://localhost:3007/graphql
REACT_APP_API_WS=ws://localhost:3007
# The frontend's exact origin must be in backend CORS_ORIGINS.
# In production use HTTPS/WSS and same-site API hosting when possible.

# Currency used by existing database amounts. Confirm before enabling conversion.
KIDIFY_CANONICAL_CURRENCY=USD
