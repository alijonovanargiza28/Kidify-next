# Public values, embedded into the browser bundle at build time. No secrets here.
# Production requires HTTPS/WSS; use localhost only in .env.development locally.
REACT_APP_API_URL=https://YOUR-BACKEND.onrender.com
# Optional: derived from REACT_APP_API_URL if omitted.
REACT_APP_API_GRAPHQL_URL=https://YOUR-BACKEND.onrender.com/graphql
REACT_APP_API_WS=wss://YOUR-BACKEND.onrender.com
# Match the currency already used by stored product/order amounts.
KIDIFY_CANONICAL_CURRENCY=USD
# Optional isolated local verification build (leave unset on Vercel):
# KIDIFY_BUILD_DIR=.next-production-check
